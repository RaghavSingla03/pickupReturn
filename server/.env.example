# Required: 'production' or 'development'. Server refuses to start if unset.
NODE_ENV=development

# Server port
PORT=3001

# REQUIRED: must be ≥32 chars and not a known placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET=5d07d15063243cd4fd60720b0d216d449f2766494094c48ad21cb2241db42111

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Allowed CORS origin for the frontend (defaults to http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# Admin credentials. In production: ADMIN_PASSWORD must be ≥12 chars and not weak.
# Generate with: openssl rand -base64 12
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Qwerty@123456
